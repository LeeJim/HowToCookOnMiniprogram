<view wx:if="{{init}}" class="loading-wrap">
  <t-loading theme="circular" size="40rpx" text="查询条码信息..." />
</view>

<view wx:elif="{{hasResult}}" class="info-card">
  <view class="info-title">商品条码信息</view>
  <view class="info-field">
    <text class="info-label">条形码</text>
    <text class="info-value">{{info.barcode}}</text>
  </view>
  <view class="info-field">
    <text class="info-label">名称</text>
    <text class="info-value info-value--bold">{{info.name}}</text>
  </view>
  <view wx:if="{{info.brand}}" class="info-field">
    <text class="info-label">品牌</text>
    <text class="info-value">{{info.brand}}</text>
  </view>
  <view wx:if="{{info.company}}" class="info-field">
    <text class="info-label">生产商</text>
    <text class="info-value">{{info.company}}</text>
  </view>
  <view wx:if="{{info.type}}" class="info-field">
    <text class="info-label">规格</text>
    <text class="info-value">{{info.type}}</text>
  </view>
  <view wx:if="{{info.origincountry}}" class="info-field">
    <text class="info-label">原产国</text>
    <text class="info-value">{{info.origincountry}}</text>
  </view>
  <view wx:if="{{info.description}}" class="info-field">
    <text class="info-label">分类</text>
    <text class="info-value">{{info.description}}</text>
  </view>
  <view wx:if="{{info.pic}}" class="info-field">
    <text class="info-label">图片</text>
    <view wx:if="{{picFailed}}" class="pic-error">
      <text class="pic-error-text">加载失败</text>
      <text class="pic-retry" bind:tap="retryImage">重新获取</text>
    </view>
    <t-image wx:else width="120" mode="widthFix" src="{{info.pic}}" bind:error="onImageError" />
  </view>
</view>

<view wx:else class="empty-card">
  <t-empty icon="info-circle-filled" description="暂无标准信息">
    <view class="empty-action" slot="action">
      <t-button wx:if="{{done && quota > 0}}" bind:tap="handleClick" loading="{{loading}}" theme="primary" size="medium">
        一键获取（{{quota}} 次机会）
      </t-button>
      <view wx:elif="{{done && quota <= 0}}" class="empty-action-btn">
        <t-button bind:tap="handleClick" theme="primary" size="medium">看广告获取次数</t-button>
        <view class="desc">看 6-15 秒广告，获取 5 次机会</view>
      </view>
      <view wx:else class="empty-loading">
        <t-loading theme="circular" size="32rpx" text="加载中..." />
      </view>
    </view>
  </t-empty>
</view>